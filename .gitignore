# Build log — a transcript of the last run, not source.
build_log.txt

# Never let credentials into a public repository.
*.local.json
*.secret
!*.example
!*.example.*

# What the two of them liked and disliked. Matched by *.local.json above; named here as
# well because it is the one file in this repository that is deliberately not published,
# and a future rename must not quietly un-ignore it. See docs/DECISIONS.md D14.
card_feedback.local.json

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store

# Files a session removed. Claude cannot delete inside a connected folder, so a removal is
# a move into here and the owner empties it. Never committed.
_to_delete/

# The memory export: Tijdcapsule cards, names, thumbs, own cards — the private layer in a file.
# Never committed, and never quoted from. See docs/DECISIONS.md D20.
vragenspel-geheugen*.json
*-geheugen-*.json
